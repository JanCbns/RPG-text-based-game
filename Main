import java.util.Random;
import java.util.Scanner;

public class GameManager {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Random rand = new Random();
        Player player = new Player("Hero");
        CombatManager cm = new CombatManager();
        int choiceCounter = 0;

        System.out.println("=== SUKADI BOI’S SYSTEM STARTING ===");

        while (player.getHp() > 0) {
            choiceCounter++;
            
            // 1. Every 5th choice forces the Boss encounter
            if (choiceCounter == 5) {
                System.out.println("\n!!! BOSS TRIGGERED: INFERNAL WITCH !!!");
                if (!cm.fight(player, new BossEnemy())) break;
                choiceCounter = 0; // Reset after boss
            } 
            else {
                // 2. Selection: Player picks 1 of 3 randomized paths
                System.out.println("\n--- Round " + choiceCounter + " / 4 ---");
                System.out.println("Choose Path: 1. Combat | 2. Item Search | 3. Shop");
                int choice = sc.nextInt();

                switch (choice) {
                    case 1 -> {
                        // Random Enemy from Coworker's classes
                        Enemy[] pool = { new Goblin(), new Skeleton(), new Troll() };
                        if (!cm.fight(player, pool[rand.nextInt(pool.length)])) break;
                    }
                    case 2 -> {
                        System.out.println("You found a stray item in the ruins!");
                        player.inventory.add(new Item("Ancient Relic"));
                    }
                    case 3 -> {
                        System.out.println("Shop (Gold: " + player.gold + "): 1. Buy Potion (20g) 2. Leave");
                        if (sc.nextInt() == 1 && player.gold >= 20) {
                            player.gold -= 20;
                            player.inventory.add(new Item("Health Potion"));
                            System.out.println("Purchased!");
                        }
                    }
                }
            }

            // 3. Camp Phase: Post-event recovery
            if (player.getHp() > 0) {
                System.out.println("\n--- CAMP PHASE ---");
                System.out.println("1. Heal Up (+30 HP) | 2. Prepare (+20 Temp Mana)");
                if (sc.nextInt() == 1) {
                    player.setHp(player.getHp() + 30);
                    System.out.println("HP Restored.");
                } else {
                    player.tempMana = 20;
                    System.out.println("Temporary Mana Prepared.");
                }
            }
        }
        System.out.println("\n[ SYSTEM ] Player HP reached 0. Game Over.");
    }
}